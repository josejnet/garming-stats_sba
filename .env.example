# Credenciales para el importador local no oficial de Garmin Connect.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# OAuth oficial de Garmin (solo funciona con acceso al Developer Program y sus endpoints).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_AUTHORIZATION_URL=
GARMIN_TOKEN_URL=
GARMIN_SCOPES=

# Limites del importador Garmin desplegado.
GARMIN_SYNC_LIMIT=
GARMIN_DETAIL_LIMIT=
GARMIN_SYNC_BATCH=

# OAuth y volumen maximo de sincronizacion de Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_SYNC_LIMIT=

# OAuth de inicio de sesion con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# PostgreSQL. POSTGRES_URL es un alias aceptado solo por scripts y por el endpoint Python.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_SSL=

# Modo personal opcional; evita la autenticacion normal y fija un unico usuario.
MOSTLYZ2_PERSONAL_MODE=
MOSTLYZ2_DEMO_USER_ID=

# Firma de sesion/OAuth, cifrado de credenciales y autorizacion del cron de Vercel.
SESSION_SECRET=
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
